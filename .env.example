# PayPal REST app credentials for the selected environment.
PAYPAL_CLIENT_ID=
# Keep the matching PayPal REST app secret private.
PAYPAL_CLIENT_SECRET=
# Use sandbox for development and smoke runs.
PAYPAL_ENV=sandbox
# Optional PayPal webhook ID configured for this app.
PAYPAL_WEBHOOK_ID=
# OpenRouter key used for supplier document extraction and plan explanations.
OPENROUTER_API_KEY=
# Optional OpenRouter model; defaults to google/gemini-2.5-flash.
AI_MODEL=
# Public origin used to build PayPal return URLs; defaults to localhost:8787.
PUBLIC_URL=
# SQLite data directory; defaults to ./data.
DATA_DIR=
# HTTP port; defaults to 8787.
PORT=
# Optional Bryntum trial or commercial license key.
BRYNTUM_LICENSE=
# Sandbox smoke buyer email.
DEMO_BUYER_EMAIL=
# Path to a real supplier source document used by the sandbox smoke run.
SMOKE_SUPPLY_FILE=
