{
  "name": "shipday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@7.3.8",
    "@bryntum/gantt-react": "^7.3.8",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
